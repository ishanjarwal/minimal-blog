# ==============================================================================
# minimal-blog - Environment Configuration Template
# Duplicate this file to .env.development or .env.production
# ==============================================================================

# Database Connection (PostgreSQL with Prisma v8)
DATABASE_URL="postgresql://postgres:password@localhost:5432/minimal_blog?schema=public"

# Admin Authentication
# Secret passkey to access /write, edit posts, and perform admin actions
ADMIN_SECRET_KEY="replace-with-a-secure-random-passkey"

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudinary Configuration (Media Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
